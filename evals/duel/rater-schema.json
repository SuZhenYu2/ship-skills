{
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "items", "summary"],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["completed", "needs_input", "aborted"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "score", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "score": { "type": "integer", "enum": [0, 1] },
          "evidence": { "type": "string" }
        }
      }
    },
    "summary": { "type": "string" }
  }
}