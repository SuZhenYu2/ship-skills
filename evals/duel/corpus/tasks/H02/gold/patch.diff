+package com.cbmc.remote.biz.product.constants;
+
+import com.ccbscf.common.CommonEnum;
+
+/**
+ * 账款金额与本金比对模式。
+ */
+public enum PrincipalCompareModeEnum implements CommonEnum {
+    /**
+     * 账款金额*融资比例=融资本金
+     */
+    PRINCIPAL("PRINCIPAL", "账款金额*融资比例=融资本金"),
+
+    /**
+     * 账款金额*融资比例=融资本金+到期利息
+     */
+    PRINCIPAL_INTEREST("PRINCIPAL_INTEREST", "账款金额*融资比例=融资本金+到期利息");
+
+    private final String code;
+    private final String name;
+
+    PrincipalCompareModeEnum(String code, String name) {
+        this.code = code;
+        this.name = name;
+    }
+
+    @Override
+    public String getCode() {
+        return code;
+    }
+
+    @Override
+    public String getName() {
+        return name;
+    }
+
+    public static PrincipalCompareModeEnum valueOfCode(String code) {
+        if (code == null || code.isEmpty()) {
+            return null;
+        }
+        for (PrincipalCompareModeEnum value : values()) {
+            if (value.getCode().equals(code)) {
+                return value;
+            }
+        }
+        return null;
+    }
+}
