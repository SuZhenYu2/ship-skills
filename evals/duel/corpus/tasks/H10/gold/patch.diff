+    /**
+     * 【息费承担方范围】校验（e收）。
+     * <p>
+     * 备注：【自定义息费方式类型】已更名为【息费承担模式】（仅前端改名），
+     * 后端字段与 DB 列名保持不变，仍为 selfInterestType。
+     * <p>
+     * 参数映射：
+     * - 【息费承担模式】   = selfInterestType
+     *   NO_SPECIAL            无特殊自定义类型 / 展示息费承担方范围
+     *   INTEREST_FEE_SEPARATE 指定息费分开承担 / 展示息费承担方范围
+     *   其它 3 种枚举          不展示
+     * - 【息费承担方范围】 = interestPayer，取值 CORE(签发方)/CORP(融资方)/SOURCE(额度来源方)，逗号分隔多值
+     * <p>
+     * 校验规则（仅 e收，不影响 e信）：
+     * 1. 上下级一致性：模式不属于展示集合（含 enableSelfInterest=false 时 selfInterestType 已被置空的场景）
+     *    → 若此时仍传入 interestPayer，直接报错（不再静默清空，避免前端契约不一致被掩盖）
+     * 2. 模式属于展示集合 → interestPayer 必传，为空则报错
+     * 3. 值域校验：按逗号拆分后逐项必须属于 CORE/CORP/SOURCE
+     *    归一化说明：按逗号拆分后逐项 trim 并剔除空项，用于兼容前端 join 产生的空格
+     *    （如 "CORE, CORP"）以及首尾/连续逗号；拆分后无有效值（如 ","）视为未传
+     * 4. 行别为民生(CMBC)或广发(GDB)时：签发方(CORE)与额度来源方(SOURCE) 二选一，不可同时勾选
+     *    （前端表现为互相置灰，后端做兜底互斥校验）
+     *
+     * @param vo        核心企业资金流类产品入参
+     * @param ciFinance 金融机构信息（用于行别判断）
+     */
+    private <T extends ProductCoreCashFlowVO> void validInterestPayerScope(T vo, TCiFinance ciFinance) {
+        String selfInterestType = vo.getSelfInterestType();
+        // 1. 上下级一致性：模式不在展示集合（含 enableSelfInterest=false）→ 传入范围即报错
+        if (!SelfInterestTypeEnum.NO_SPECIAL.getCode().equals(selfInterestType)
+                && !SelfInterestTypeEnum.INTEREST_FEE_SEPARATE.getCode().equals(selfInterestType)) {
+            if (StringUtils.isNotBlank(vo.getInterestPayer())) {
+                throw new CcbscfBizException(ProductApiOpError.CUSTOMIZE_ERROR,
+                        "当前【息费承担模式】不支持配置【息费承担方范围】，请清空后重新提交");
+            }
+            return;
+        }
+        // 2. 模式属于展示集合 → 息费承担方范围必传
+        //    先做归一化：按逗号拆分、逐项 trim、剔除空项
+        //    不能直接用 String.split：它会丢弃尾部空串，导致 "," 这类无有效值的入参绕过后续值域白名单
+        String interestPayer = vo.getInterestPayer();
+        List<String> interestPayerItems = new ArrayList<>();
+        if (StringUtils.isNotBlank(interestPayer)) {
+            for (String interestPayerItem : StringUtils.split(interestPayer, ProductCommonConstants.SPLIT)) {
+                String item = StringUtils.trim(interestPayerItem);
+                if (StringUtils.isNotBlank(item)) {
+                    interestPayerItems.add(item);
+                }
+            }
+        }
+        if (interestPayerItems.isEmpty()) {
+            throw new CcbscfBizException(ProductApiOpError.DATE_NOT_FOUNT, "息费承担方范围");
+        }
+        // 3. 值域校验（多值，逗号分隔），同时记录是否含签发方/额度来源方
+        boolean containsIssuePayer = false;
+        boolean containsSourcePayer = false;
+        for (String interestPayerItem : interestPayerItems) {
+            if (!ProductCommonConstants.INTEREST_PAYER_LIST.contains(interestPayerItem)) {
+                throw new CcbscfBizException(ProductApiOpError.CUSTOMIZE_ERROR,
+                        MessageFormat.format("未知的息费承担方范围[{0}]", interestPayerItem));
+            }
+            if (ProductCommonConstants.INTEREST_PAYER_CORE.equals(interestPayerItem)) {
+                containsIssuePayer = true;
+            }
+            if (ProductCommonConstants.INTEREST_PAYER_SOURCE.equals(interestPayerItem)) {
+                containsSourcePayer = true;
+            }
+        }
+        // 4. 民生/广发：签发方与额度来源方 二选一（不可同时勾选）
+        if (Objects.nonNull(ciFinance)) {
+            BankCategoryEnum bankCategory = ciFinance.getBankCategory();
+            if ((BankCategoryEnum.CMBC.equals(bankCategory) || BankCategoryEnum.GDB.equals(bankCategory))
+                    && SelfInterestTypeEnum.INTEREST_FEE_SEPARATE.getCode().equals(selfInterestType)
+                    && containsIssuePayer && containsSourcePayer) {
+                throw new CcbscfBizException(ProductApiOpError.CUSTOMIZE_ERROR,
+                        "金融机构行别为民生或广发时，息费承担方范围中签发方与额度来源方不可同时勾选");
+            }
+        }
+    }
