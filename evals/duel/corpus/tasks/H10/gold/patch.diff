+-- e收 新增【息费承担方范围】历史数据处理
+-- 需求：原参数【自定义息费方式类型】更名为【息费承担模式】，新增【息费承担方范围】
+-- 说明：e收 复用 INTEREST_PAYER 字段（息费承担方范围），无需 DDL
+--      仅处理商银(CBMC)租户；ccbscf 目录不放此脚本
+-- 参考：V2026082802__核心企业平台产品白条新增终审岗位字段历史数据处理.sql
+-- 回合来源：ccbscf-biz-product 分支 feature-20261016-fee-7094921137（老仓编号 V2026101601，
+--          新仓 cbmc 目录该版本号已被「核心企业平台产品e信新增签发直联参数」占用，故顺延为 V2026101603）
+
+-- 正式表：核心企业金融机构产品（e收）
+-- 息费承担方范围默认值 = 签发方(CORE) + 融资方(CORP)
+UPDATE T_PRODUCT_CASH_FLOW
+   SET INTEREST_PAYER = 'CORE,CORP'
+ WHERE PRODUCT_TYPE = 'FACTORING_WITHOUT_RESOURCE_ESTP'
+   AND ENABLE_SELF_INTEREST = '1'
+   AND SELF_INTEREST_TYPE IN ('NO_SPECIAL', 'INTEREST_FEE_SEPARATE')
+   AND (INTEREST_PAYER IS NULL OR INTEREST_PAYER = '')
+   AND DELETE_TIME IS NULL;
+
+-- 临时表：核心企业金融机构产品（e收）_待审核
+UPDATE T_PRODUCT_CASH_FLOW_T
+   SET INTEREST_PAYER = 'CORE,CORP'
+ WHERE PRODUCT_TYPE = 'FACTORING_WITHOUT_RESOURCE_ESTP'
+   AND ENABLE_SELF_INTEREST = '1'
+   AND SELF_INTEREST_TYPE IN ('NO_SPECIAL', 'INTEREST_FEE_SEPARATE')
+   AND (INTEREST_PAYER IS NULL OR INTEREST_PAYER = '')
+   AND IS_OVER = '0';
