+package com.ccbscf.api.partner.ci.controller;
+
+import com.ccbscf.api.partner.ci.model.SaasLoginUserInfoReqVO;
+import com.ccbscf.api.partner.ci.model.SaasLoginUserInfoRespVO;
+import com.ccbscf.api.partner.exception.ApiPartnerError;
+import com.ccbscf.common.exception.CcbscfBizException;
+import com.ccbscf.common.web.model.RestResult;
+import com.ccbscf.remote.biz.ci.client.SaasLoginService;
+import com.ccbscf.remote.biz.ci.model.login.SaasLoginUserInfoReqDTO;
+import com.ccbscf.remote.biz.ci.model.login.SaasLoginUserInfoResDTO;
+import io.swagger.annotations.Api;
+import io.swagger.annotations.ApiOperation;
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestMethod;
+import org.springframework.web.bind.annotation.RestController;
+
+/**
+ * 商银SaaS单点过程查询用户信息服务
+ *
+ * @author wangsu
+ * @date 2026/11/27
+ */
+@RestController
+@Api(tags = "商银SaaS单点过程查询用户信息服务")
+public class SaasLoginUserInfoController {
+
+    /**
+     * 系统异常提示
+     */
+    private static final String MSG_SYSTEM_ERROR = "系统异常";
+
+    @Autowired
+    private SaasLoginService saasLoginService;
+
+    /**
+     * 查询单点登录用户信息
+     *
+     * @param reqVO 用户信息查询请求
+     * @return 用户信息
+     */
+    @ApiOperation("查询单点登录用户信息")
+    @RequestMapping(value = "/v1/cbmc/ci/saas/login/userinfo", method = RequestMethod.POST)
+    public SaasLoginUserInfoRespVO queryUserInfo(@RequestBody(required = false) SaasLoginUserInfoReqVO reqVO) {
+        // 校验请求参数
+        checkReqParam(reqVO);
+
+        // 调用下游服务查询单点登录用户信息
+        RestResult<SaasLoginUserInfoResDTO> result = queryLoginUserInfoFromBiz(reqVO);
+
+        // 转换下游查询结果
+        return buildUserInfoResp(result);
+    }
+
+    /**
+     * 校验用户信息查询请求参数
+     *
+     * @param reqVO 用户信息查询请求
+     */
+    private void checkReqParam(SaasLoginUserInfoReqVO reqVO) {
+        // 请求参数非空校验，校验失败直接抛出业务异常
+        if (reqVO == null) {
+            throw new CcbscfBizException(ApiPartnerError.COMMON_ERROR_MSG, "请求参数不能为空");
+        }
+        if (StringUtils.isBlank(reqVO.getFkCorp())) {
+            throw new CcbscfBizException(ApiPartnerError.COMMON_ERROR_MSG, "企业编号不能为空");
+        }
+        if (StringUtils.isBlank(reqVO.getFkUser())) {
+            throw new CcbscfBizException(ApiPartnerError.COMMON_ERROR_MSG, "用户编号不能为空");
+        }
+    }
+
+    /**
+     * 调用下游服务查询单点登录用户信息
+     *
+     * @param reqVO 用户信息查询请求
+     * @return 下游查询结果
+     */
+    private RestResult<SaasLoginUserInfoResDTO> queryLoginUserInfoFromBiz(SaasLoginUserInfoReqVO reqVO) {
+        // 组装下游用户信息查询请求
+        SaasLoginUserInfoReqDTO reqDTO = new SaasLoginUserInfoReqDTO();
+        reqDTO.setZoneTenantCode(reqVO.getZoneTenantCode());
+        reqDTO.setFkCorp(reqVO.getFkCorp());
+        reqDTO.setFkUser(reqVO.getFkUser());
+
+        // 调用下游服务查询单点登录用户信息
+        RestResult<SaasLoginUserInfoResDTO> result = saasLoginService.queryLoginUserInfo(reqDTO);
+        if (result == null) {
+            throw new CcbscfBizException(ApiPartnerError.COMMON_ERROR_MSG, MSG_SYSTEM_ERROR);
+        }
+        return result;
+    }
+
+    /**
+     * 转换下游查询结果为接口响应
+     *
+     * @param result 下游查询结果
+     * @return 用户信息响应
+     */
+    private SaasLoginUserInfoRespVO buildUserInfoResp(RestResult<SaasLoginUserInfoResDTO> result) {
+        SaasLoginUserInfoRespVO respVO = new SaasLoginUserInfoRespVO();
+        respVO.createCode(result);
+
+        // 下游返回业务失败时，直接透传下游错误信息
+        if (!RestResult.RETURN_CODE_SUCCESS.equals(result.getCode())) {
+            return respVO;
+        }
+
+        // 下游返回成功但数据为空，按系统异常处理
+        if (result.getData() == null) {
+            throw new CcbscfBizException(ApiPartnerError.COMMON_ERROR_MSG, MSG_SYSTEM_ERROR);
+        }
+
+        // 转换下游用户信息为接口响应
+        SaasLoginUserInfoResDTO resDTO = result.getData();
+        respVO.setPkPerson(resDTO.getPkPerson());
+        respVO.setPersonName(resDTO.getPersonName());
+        respVO.setIdType(resDTO.getIdType());
+        respVO.setIdCode(resDTO.getIdCode());
+        respVO.setMobilePhone(resDTO.getMobilePhone());
+        respVO.setRoles(resDTO.getRoles());
+        respVO.setSoftCaAuthState(resDTO.getSoftCaAuthState());
+        respVO.setCreateTime(resDTO.getCreateTime());
+
+        return respVO;
+    }
+}
